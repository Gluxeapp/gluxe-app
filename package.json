{
  "name": "gluxe-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:genera": "drizzle-kit generate",
    "db:aggiorna": "node --env-file=.env.local scripts/aggiorna-database.mjs",
    "crea-staff": "node --env-file=.env.local scripts/crea-staff.mjs",
    "db:aggiorna:produzione": "node --env-file=.env.local scripts/aggiorna-database.mjs --produzione",
    "db:riapplica": "node --env-file=.env.local scripts/riapplica-migrazione.mjs",
    "db:annulla": "node --env-file=.env.local scripts/annulla-migrazione.mjs",
    "db:seme-catalogo": "node --env-file=.env.local scripts/seme-catalogo.ts",
    "stripe:inoltra": "node --env-file=.env.local scripts/inoltra-stripe.mjs",
    "stripe:metodi": "node --env-file=.env.local scripts/stripe-metodi-pagamento.mjs",
    "prova:garanzie": "node --env-file=.env.local scripts/prova-garanzie.mjs",
    "controlla:segreti": "node scripts/controlla-segreti.mjs",
    "prebuild": "node scripts/controlla-segreti.mjs",
    "prepare": "node -e \"if(require('fs').existsSync('.git'))require('child_process').execSync('git config core.hooksPath .githooks')\"",
    "db:seme-rete-prova": "node --env-file=.env.local scripts/seme-rete-prova.mjs",
    "prova:licenza": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config prove/licenza/vitest.config.mts",
    "prova:fase7": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config prove/fase7/vitest.config.mts",
    "prova:fase6": "bash prove/fase6/azzera.sh && node --env-file=.env.local node_modules/vitest/vitest.mjs run --config prove/fase6/vitest.config.mts && bash prove/fase6/azzera.sh"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "8.23.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^63.1.2",
    "vitest": "^5.0.3"
  }
}
