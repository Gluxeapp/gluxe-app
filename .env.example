# Copia questo file come .env.local e inserisci i valori veri.
# .env.local NON va mai condiviso né caricato su GitHub.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (porta 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:LA-TUA-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Email (https://resend.com → API Keys). Senza dominio verificato Resend invia solo
# all'indirizzo con cui hai creato l'account.
RESEND_API_KEY=re_xxxxxxxx
# Mittente: si cambia quando il dominio aziendale è verificato su Resend.
# EMAIL_MITTENTE=G LUXE <noreply@gluxe.it>

# Indirizzo pubblico dell'app (link nelle email). Su Vercel non serve.
# APP_URL=https://gluxe-app.vercel.app

# Pagamenti Stripe (https://dashboard.stripe.com → Sviluppatori → Chiavi API).
# Sul computer e nelle anteprime solo chiavi di PROVA (pk_test_… / sk_test_…).
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Metodi di pagamento ammessi (carta, Klarna, PayPal): codice pmc_… creato con npm run stripe:metodi
STRIPE_CONFIGURAZIONE_PAGAMENTI=pmc_xxxxxxxx
# Firma dei webhook: su Vercel quella dell'endpoint creato su Stripe (whsec_…);
# sul computer un valore qualsiasi, usato da npm run stripe:inoltra.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Solo per le prove sul database di prova (credenziali finte, mai reali):
# PROVA_INCARICATA_EMAIL=…
# PROVA_INCARICATA_PASSWORD=…
# PROVA_STAFF_ORDINI_EMAIL=…
# PROVA_STAFF_ORDINI_PASSWORD=…
