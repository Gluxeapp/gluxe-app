# Copia questo file come .env.local e inserisci i valori veri.
# .env.local NON va mai condiviso né caricato su GitHub.

# Supabase → Project Settings → Database → Connection string → "Session pooler" (porta 5432).
DATABASE_URL=postgresql://postgres.xxxxxxxx:LA-TUA-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Email (https://resend.com → API Keys). Senza dominio verificato Resend invia solo
# all'indirizzo con cui hai creato l'account.
RESEND_API_KEY=re_xxxxxxxx
# Mittente: si cambia quando il dominio aziendale è verificato su Resend.
# EMAIL_MITTENTE=G LUXE <noreply@gluxe.it>

# Indirizzo pubblico dell'app (link nelle email). Su Vercel non serve.
# APP_URL=https://gluxe-app.vercel.app
